# Polymarket API Configuration
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com

# Polymarket API Keys (optional for trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/polymarket.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/polymarket

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Paper Trading Configuration
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_BALANCE=10000

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Notification Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# External API Keys (optional)
COINGECKO_API_KEY=
TWITTER_BEARER_TOKEN=
NEWSAPI_KEY=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/polymarket-lab.log

# Scheduler Configuration
SCAN_INTERVAL_MINUTES=5
SIGNAL_GENERATION_INTERVAL_MINUTES=15
BACKTEST_INTERVAL_HOURS=24

# Trading Configuration
MAX_POSITION_SIZE=1000
MAX_PORTFOLIO_RISK=0.05  # 5%
STOP_LOSS_PCT=0.10  # 10%
TAKE_PROFIT_PCT=0.20  # 20%

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG=true
